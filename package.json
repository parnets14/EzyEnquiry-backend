{
  "name": "ezyenquiry-backend",
  "version": "1.0.0",
  "description": "EzyEnquiry Tiles Industry ERP + B2B Marketplace Backend API",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js"
  },
  "nodemonConfig": {
    "watch": [
      "src"
    ],
    "ext": "js,json",
    "ignore": [
      "src/**/*.test.js",
      "logs/*"
    ],
    "delay": "500"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "compression": "1.7.4",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.19.2",
    "express-async-errors": "3.1.1",
    "express-rate-limit": "7.4.0",
    "express-validator": "7.2.0",
    "firebase-admin": "^14.3.0",
    "helmet": "7.1.0",
    "jsonwebtoken": "9.0.2",
    "mongoose": "^8.5.0",
    "morgan": "1.10.0",
    "multer": "1.4.5-lts.1",
    "nodemailer": "6.9.14",
    "uuid": "10.0.0",
    "winston": "3.14.2"
  },
  "devDependencies": {
    "nodemon": "3.1.4"
  }
}
